{
  "name": "eep-student-showcase",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "test": "vitest run",
    "audit:site": "node scripts/site-audit/run-site-audit.mjs",
    "audit:site:preview": "node scripts/site-audit/run-site-audit.mjs --mode preview --base-url https://ied-hub--final-review-0w7hj3l0.web.app",
    "test:route-scroll": "node scripts/run-route-scroll-test-v2.mjs",
    "test:rules": "firebase emulators:exec --only firestore \"vitest run --config vitest.rules.config.ts\"",
    "emulators:start": "firebase emulators:start --only auth,firestore,functions",
    "emulators:seed-owner": "npm.cmd --prefix functions run seed:owner:local",
    "emulators:smoke-staff": "firebase emulators:exec --only auth,firestore,functions \"npm.cmd --prefix functions run smoke:local\""
  },
  "dependencies": {
    "firebase": "^12.14.0",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "react-router-dom": "^7.17.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.11.3",
    "@eslint/js": "^10.0.1",
    "@firebase/rules-unit-testing": "^5.0.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^24.12.3",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "chrome-launcher": "^1.2.1",
    "eslint": "^10.3.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "firebase-tools": "^15.21.0",
    "globals": "^17.6.0",
    "jsdom": "^29.1.1",
    "lighthouse": "^12.8.2",
    "playwright": "^1.61.0",
    "pngjs": "^7.0.0",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.59.2",
    "vite": "^8.0.12",
    "vitest": "^4.1.9"
  }
}
