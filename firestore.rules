rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isAdmin() {
      return request.auth != null
        && (
          isBootstrapSuperAdmin()
          || (
            exists(/databases/$(database)/documents/adminUsers/$(request.auth.uid))
            && get(/databases/$(database)/documents/adminUsers/$(request.auth.uid)).data.active == true
          )
        );
    }

    function isBootstrapSuperAdmin() {
      return request.auth != null
        && request.auth.token.email == 'gastonstuart@googlemail.com';
    }

    function adminRecord() {
      return get(/databases/$(database)/documents/adminUsers/$(request.auth.uid)).data;
    }

    function isSuperAdmin() {
      return isBootstrapSuperAdmin()
        || (
          isAdmin()
          && adminRecord().role == 'superAdmin'
        );
    }

    function canManageSection(sectionId) {
      return canCreateContent(sectionId) || canEditContent(sectionId) || canPublishContent(sectionId);
    }

    function hasStaffPermissions() {
      return isAdmin() && adminRecord().keys().hasAny(['permissions']);
    }

    function hasPermission(permission) {
      return isSuperAdmin()
        || (
          isAdmin()
          && hasStaffPermissions()
          && adminRecord().permissions[permission] == true
        );
    }

    function hasSectionAccess(sectionId) {
      return isSuperAdmin()
        || (
          isAdmin()
          && (
            sectionId in adminRecord().allowedSectionIds
            || '*' in adminRecord().allowedSectionIds
          )
        );
    }

    function hasLegacySectionAccess(sectionId) {
      return isAdmin()
        && !hasStaffPermissions()
        && adminRecord().role == 'editor'
        && sectionId in adminRecord().allowedSectionIds;
    }

    function canManageProjects() {
      return isSuperAdmin()
        || (
          hasSectionAccess('eep')
          && (
            hasPermission('manageProjects')
            || hasLegacySectionAccess('eep')
          )
        );
    }

    function canManageUsers() {
      return hasPermission('manageUsers');
    }

    function canManageHubSettings(sectionId) {
      return hasSectionAccess(sectionId)
        && (
          hasPermission('manageHubSettings')
          || hasLegacySectionAccess(sectionId)
        );
    }

    function canCreateContent(sectionId) {
      return hasSectionAccess(sectionId)
        && (
          hasPermission('createContent')
          || hasLegacySectionAccess(sectionId)
        );
    }

    function canEditContent(sectionId) {
      return hasSectionAccess(sectionId)
        && (
          hasPermission('editContent')
          || hasLegacySectionAccess(sectionId)
        );
    }

    function canPublishContent(sectionId) {
      return hasSectionAccess(sectionId)
        && (
          hasPermission('publishContent')
          || hasLegacySectionAccess(sectionId)
        );
    }

    function canDeleteContent(sectionId) {
      return hasSectionAccess(sectionId)
        && (
          hasPermission('deleteContent')
          || hasLegacySectionAccess(sectionId)
        );
    }

    function canViewAuditLog() {
      return hasPermission('viewAuditLog');
    }

    function contentStatusDidChange() {
      return resource.data.status != request.resource.data.status;
    }

    function publishingStatusDidChange() {
      return contentStatusDidChange()
        && (
          request.resource.data.status == 'published'
          || resource.data.status == 'published'
          || request.resource.data.status == 'hidden'
        );
    }

    function isShortString(value, maxLength) {
      return value is string && value.size() > 0 && value.size() <= maxLength;
    }

    function isOptionalUrl(value) {
      return value is string && (value == '' || value.matches('https://.*'));
    }

    function isValidProjectCreate() {
      return request.resource.data.keys().hasOnly([
        'title',
        'groupName',
        'className',
        'members',
        'category',
        'description',
        'audience',
        'impact',
        'googleSitesUrl',
        'imageUrl',
        'status',
        'featured',
        'studentPick',
        'createdAt',
        'updatedAt'
      ])
      && isShortString(request.resource.data.title, 120)
      && isShortString(request.resource.data.groupName, 120)
      && isShortString(request.resource.data.className, 80)
      && isShortString(request.resource.data.members, 300)
      && request.resource.data.category in [
        'Local Businesses',
        'School Clubs',
        'Travel & Food Guides',
        'Student Help',
        'Campaigns',
        'Creative Projects'
      ]
      && isShortString(request.resource.data.description, 900)
      && isShortString(request.resource.data.audience, 500)
      && isShortString(request.resource.data.impact, 500)
      && request.resource.data.googleSitesUrl is string
      && request.resource.data.googleSitesUrl.matches('https://sites\\.google\\.com/.*')
      && isOptionalUrl(request.resource.data.imageUrl)
      && request.resource.data.status == 'pending'
      && request.resource.data.featured == false
      && request.resource.data.studentPick == false
      && request.resource.data.createdAt == request.time
      && request.resource.data.updatedAt == request.time;
    }

    match /projects/{projectId} {
      allow read: if resource.data.status == 'approved' || canManageProjects();
      allow create: if isValidProjectCreate() || canManageProjects();
      allow update, delete: if canManageProjects();
    }

    match /contentItems/{contentItemId} {
      allow read: if resource.data.status == 'published' || canManageSection(resource.data.sectionId);
      allow create: if canCreateContent(request.resource.data.sectionId)
        && (
          request.resource.data.status != 'published'
          || canPublishContent(request.resource.data.sectionId)
        );
      allow update: if canEditContent(resource.data.sectionId)
        && canEditContent(request.resource.data.sectionId)
        && (
          !publishingStatusDidChange()
          || (
            canPublishContent(resource.data.sectionId)
            && canPublishContent(request.resource.data.sectionId)
          )
        );
      allow delete: if canDeleteContent(resource.data.sectionId);
    }

    match /hubPages/{hubPageId} {
      allow read: if true;
      allow create, update, delete: if canManageHubSettings(hubPageId);
    }

    match /adminUsers/{adminUid} {
      allow get: if request.auth != null && (request.auth.uid == adminUid || canManageUsers());
      allow list: if canManageUsers();
      allow create, update, delete: if false;
    }

    match /staffUsernames/{username} {
      allow read, write: if false;
    }

    match /auditLogs/{auditId} {
      allow read: if canViewAuditLog();
      allow create, update, delete: if false;
    }
  }
}
