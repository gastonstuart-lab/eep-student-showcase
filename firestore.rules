rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isAdmin() {
      return request.auth != null
        && (
          isBootstrapSuperAdmin()
          || (
            exists(/databases/$(database)/documents/adminUsers/$(request.auth.uid))
            && get(/databases/$(database)/documents/adminUsers/$(request.auth.uid)).data.active == true
          )
        );
    }

    function isBootstrapSuperAdmin() {
      return request.auth != null
        && request.auth.token.email == 'gastonstuart@googlemail.com';
    }

    function adminRecord() {
      return get(/databases/$(database)/documents/adminUsers/$(request.auth.uid)).data;
    }

    function isSuperAdmin() {
      return isBootstrapSuperAdmin()
        || (
          isAdmin()
          && adminRecord().role == 'superAdmin'
        );
    }

    function canManageSection(sectionId) {
      return canCreateContent(sectionId) || canEditContent(sectionId) || canPublishContent(sectionId);
    }

    function hasStaffPermissions() {
      return isAdmin() && adminRecord().keys().hasAny(['permissions']);
    }

    function hasPermission(permission) {
      return isSuperAdmin()
        || (
          isAdmin()
          && hasStaffPermissions()
          && adminRecord().permissions[permission] == true
        );
    }

    function hasSectionAccess(sectionId) {
      return isSuperAdmin()
        || (
          isAdmin()
          && (
            sectionId in adminRecord().allowedSectionIds
            || '*' in adminRecord().allowedSectionIds
          )
        );
    }

    function hasLegacySectionAccess(sectionId) {
      return isAdmin()
        && !hasStaffPermissions()
        && adminRecord().role == 'editor'
        && sectionId in adminRecord().allowedSectionIds;
    }

    function canManageProjects() {
      return isSuperAdmin()
        || (
          hasSectionAccess('eep')
          && (
            hasPermission('manageProjects')
            || hasLegacySectionAccess('eep')
          )
        );
    }

    function canManageUsers() {
      return hasPermission('manageUsers');
    }

    function canManageHubSettings(sectionId) {
      return hasSectionAccess(sectionId)
        && (
          hasPermission('manageHubSettings')
          || hasLegacySectionAccess(sectionId)
        );
    }

    function canCreateContent(sectionId) {
      return hasSectionAccess(sectionId)
        && (
          hasPermission('createContent')
          || hasLegacySectionAccess(sectionId)
        );
    }

    function canEditContent(sectionId) {
      return hasSectionAccess(sectionId)
        && (
          hasPermission('editContent')
          || hasLegacySectionAccess(sectionId)
        );
    }

    function canPublishContent(sectionId) {
      return hasSectionAccess(sectionId)
        && (
          hasPermission('publishContent')
          || hasLegacySectionAccess(sectionId)
        );
    }

    function canCreateAndPublishContent(sectionId) {
      return isSuperAdmin()
        || (
          isAdmin()
          && (
            sectionId in adminRecord().allowedSectionIds
            || '*' in adminRecord().allowedSectionIds
          )
          && (
            (
              hasStaffPermissions()
              && adminRecord().permissions.createContent == true
              && adminRecord().permissions.publishContent == true
            )
            || (
              !hasStaffPermissions()
              && adminRecord().role == 'editor'
              && sectionId in adminRecord().allowedSectionIds
            )
          )
        );
    }

    function canEditAndPublishContent(sectionId) {
      return isSuperAdmin()
        || (
          isAdmin()
          && (
            sectionId in adminRecord().allowedSectionIds
            || '*' in adminRecord().allowedSectionIds
          )
          && (
            (
              hasStaffPermissions()
              && adminRecord().permissions.editContent == true
              && adminRecord().permissions.publishContent == true
            )
            || (
              !hasStaffPermissions()
              && adminRecord().role == 'editor'
              && sectionId in adminRecord().allowedSectionIds
            )
          )
        );
    }

    function canDeleteContent(sectionId) {
      return hasSectionAccess(sectionId)
        && (
          hasPermission('deleteContent')
          || hasLegacySectionAccess(sectionId)
        );
    }

    function canViewAuditLog() {
      return hasPermission('viewAuditLog');
    }

    function contentStatusDidChange() {
      return resource.data.status != request.resource.data.status;
    }

    function contentSectionDidChange() {
      return resource.data.sectionId != request.resource.data.sectionId;
    }

    function isPublishControlledStatus(status) {
      return status == 'scheduled'
        || status == 'published'
        || status == 'hidden';
    }

    function requestedStatusRequiresPublish() {
      return isPublishControlledStatus(request.resource.data.status);
    }

    function publishControlledStatusDidChange() {
      return contentStatusDidChange()
        && (
          isPublishControlledStatus(resource.data.status)
          || isPublishControlledStatus(request.resource.data.status)
        );
    }

    function isShortString(value, maxLength) {
      return value is string && value.size() > 0 && value.size() <= maxLength;
    }

    function isOptionalUrl(value) {
      return value is string && (value == '' || value.matches('https://.*'));
    }

    function isOptionalDateString(value) {
      return value is string && (value == '' || value.matches('^\\d{4}-\\d{2}-\\d{2}$'));
    }

    function isOptionalPlainText(value, maxLength) {
      return value is string && value.size() > 0 && value.size() <= maxLength && value.matches('^[^<>\\r\\n]*$');
    }

    function hasContentUrl() {
      return (request.resource.data.linkUrl is string && request.resource.data.linkUrl != '')
        || (request.resource.data.mediaUrl is string && request.resource.data.mediaUrl != '');
    }

    function isValidContentItem() {
      return request.resource.data.keys().hasOnly([
        'title',
        'summary',
        'body',
        'type',
        'department',
        'sectionId',
        'sectionName',
        'status',
        'featured',
        'mediaUrl',
        'linkUrl',
        'eventDate',
        'imageUrl',
        'displayStyle',
        'contentWidth',
        'layoutColumns',
        'imagePlacement',
        'textAlignment',
        'accentStyle',
        'badgeText',
        'ctaStyle',
        'cardShape',
        'contentDensity',
        'imageRatio',
        'badgeStyle',
        'backgroundStyle',
        'publishDate',
        'expiryDate',
        'actionLabel',
        'actionUrl',
        'actionStyle',
        'actionNewTab',
        'secondaryActionLabel',
        'secondaryActionUrl',
        'secondaryActionStyle',
        'secondaryActionNewTab',
        'imageAlt',
        'thumbnailUrl',
        'hideImage',
        'pinned',
        'createdBy',
        'sortOrder',
        'createdAt',
        'updatedAt'
      ])
      && isShortString(request.resource.data.title, 120)
      && isShortString(request.resource.data.summary, 220)
      && request.resource.data.body is string && request.resource.data.body.size() <= 5000
      && request.resource.data.type in [
        'announcement',
        'event',
        'video',
        'resource',
        'studentWork',
        'link'
      ]
      && request.resource.data.department in ['IED', 'EEP', 'ESL']
      && isShortString(request.resource.data.sectionId, 80)
      && isShortString(request.resource.data.sectionName, 120)
      && request.resource.data.status in ['draft', 'scheduled', 'published', 'hidden']
      && request.resource.data.featured is bool
      && isOptionalUrl(request.resource.data.mediaUrl)
      && isOptionalUrl(request.resource.data.linkUrl)
      && isOptionalDateString(request.resource.data.eventDate)
      && isOptionalUrl(request.resource.data.imageUrl)
      && request.resource.data.get('displayStyle', 'standard') in ['standard', 'featured', 'compact', 'banner', 'media', 'photoStory', 'quickLink', 'eventCard', 'quote', 'minimal']
      && request.resource.data.get('contentWidth', 'medium') in ['normal', 'small', 'medium', 'wide', 'full']
      && request.resource.data.get('layoutColumns', 'auto') in ['auto', 'one', 'two', 'three']
      && request.resource.data.get('imagePlacement', 'top') in ['top', 'left', 'right', 'background', 'fullBleed', 'hidden']
      && request.resource.data.get('textAlignment', 'left') in ['left', 'center']
      && request.resource.data.get('accentStyle', 'neutral') in ['none', 'neutral', 'ied', 'eep', 'esl', 'warm', 'performance', 'science', 'social', 'dark']
      && (!request.resource.data.keys().hasAny(['badgeText']) || isOptionalPlainText(request.resource.data.badgeText, 24))
      && request.resource.data.get('ctaStyle', 'hidden') in ['link', 'primary', 'secondary', 'hidden']
      && request.resource.data.get('cardShape', 'standard') in ['soft', 'standard', 'square', 'minimal']
      && request.resource.data.get('contentDensity', 'comfortable') in ['compact', 'comfortable', 'spacious']
      && request.resource.data.get('imageRatio', 'landscape') in ['landscape', 'square', 'portrait', 'banner']
      && request.resource.data.get('badgeStyle', 'subtle') in ['subtle', 'solid', 'outline', 'none']
      && request.resource.data.get('backgroundStyle', 'plain') in ['plain', 'tint', 'gradient', 'image', 'darkOverlay']
      && request.resource.data.get('actionStyle', 'hidden') in ['link', 'primary', 'secondary', 'hidden']
      && request.resource.data.get('secondaryActionStyle', 'hidden') in ['link', 'primary', 'secondary', 'hidden']
      && request.resource.data.get('hideImage', false) is bool
      && request.resource.data.get('pinned', false) is bool
      && (request.resource.data.get('ctaStyle', 'hidden') == 'hidden' || hasContentUrl())
      && (!request.resource.data.keys().hasAny(['sortOrder']) || request.resource.data.sortOrder is number);
    }

    function isValidProjectCreate() {
      return request.resource.data.keys().hasOnly([
        'title',
        'groupName',
        'className',
        'members',
        'category',
        'description',
        'audience',
        'impact',
        'googleSitesUrl',
        'imageUrl',
        'status',
        'featured',
        'studentPick',
        'createdAt',
        'updatedAt'
      ])
      && isShortString(request.resource.data.title, 120)
      && isShortString(request.resource.data.groupName, 120)
      && isShortString(request.resource.data.className, 80)
      && isShortString(request.resource.data.members, 300)
      && request.resource.data.category in [
        'Local Businesses',
        'School Clubs',
        'Travel & Food Guides',
        'Student Help',
        'Campaigns',
        'Creative Projects'
      ]
      && isShortString(request.resource.data.description, 900)
      && isShortString(request.resource.data.audience, 500)
      && isShortString(request.resource.data.impact, 500)
      && request.resource.data.googleSitesUrl is string
      && request.resource.data.googleSitesUrl.matches('https://sites\\.google\\.com/.*')
      && isOptionalUrl(request.resource.data.imageUrl)
      && request.resource.data.status == 'pending'
      && request.resource.data.featured == false
      && request.resource.data.studentPick == false
      && request.resource.data.createdAt == request.time
      && request.resource.data.updatedAt == request.time;
    }

    match /projects/{projectId} {
      allow read: if resource.data.status == 'approved' || canManageProjects();
      allow create: if isValidProjectCreate() || canManageProjects();
      allow update, delete: if canManageProjects();
    }

    match /contentItems/{contentItemId} {
      allow read: if resource.data.status == 'published' || canManageSection(resource.data.sectionId);
      allow create: if isValidContentItem()
        && (
          (
            !requestedStatusRequiresPublish()
            && canCreateContent(request.resource.data.sectionId)
          )
          || (
            requestedStatusRequiresPublish()
            && canCreateAndPublishContent(request.resource.data.sectionId)
          )
        );
      allow update: if isValidContentItem()
        && (
          (
            !publishControlledStatusDidChange()
            && canEditContent(resource.data.sectionId)
            && (
              !contentSectionDidChange()
              || canEditContent(request.resource.data.sectionId)
            )
          )
          || (
            publishControlledStatusDidChange()
            && canEditAndPublishContent(resource.data.sectionId)
            && (
              !contentSectionDidChange()
              || canEditAndPublishContent(request.resource.data.sectionId)
            )
          )
        );
      allow delete: if canDeleteContent(resource.data.sectionId);
    }

    match /hubPages/{hubPageId} {
      allow read: if true;
      allow create, update, delete: if canManageHubSettings(hubPageId);
    }

    match /adminUsers/{adminUid} {
      allow get: if request.auth != null && (request.auth.uid == adminUid || canManageUsers());
      allow list: if canManageUsers();
      allow create, update, delete: if false;
    }

    match /staffUsernames/{username} {
      allow read, write: if false;
    }

    match /auditLogs/{auditId} {
      allow read: if canViewAuditLog();
      allow create, update, delete: if false;
    }
  }
}
